# Root-level ignores (backend/frontend also have their own .gitignore files)

# Local env / secrets
.env
.env.*
!.env.example
!**/.env.example

# Dependencies
**/node_modules/
**/vendor/

# Uploaded / generated storage (symlink + files); keep Laravel placeholders tracked
backend/public/storage
backend/storage/app/public/*
!backend/storage/app/public/.gitignore

# Build / cache
**/dist/
**/build/
frontend/.vite/
*.log

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Large binary assets accidentally at repo root
*.pdf
*.docx
*.pptx

# Local probe / debug / scratch scripts (never ship)
backend/_*.php
backend/_*/
backend/_*.py
backend/_*.json
/fix_styles.py
/rewrite.py
/test_auth.py
/test_endpoints.py
/test_req.py
/test_tinker.php
/test_regex.js
/find_*.js
/find_*.py
/fix_*.py
/fix_*.js
/generate_*.py

# QA audit outputs (scripts may remain if tracked; results stay local)
qa/**/*_results.json
qa/**/screenshots/

# Junk / local scratch files
_docx_extract.txt
tinker_check.php
**/tinker_check.php
backend/storage/audit_discover.php
backend/php-local.ini
/logo.jpg

# Orphan root lockfile (frontend lockfile lives in frontend/)
/package-lock.json

